  <key>actions</key>
  <array>
    <dict>
      <key>action</key>
      <dict>
        <key>ActionBundlePath</key>
        <string>/System/Library/Automator/Run Shell Script.action</string>
        <key>ActionName</key>
        <string>Run Shell Script</string>
        <key>ActionParameters</key>
        <dict>
          <key>CheckedForUserDefaultShell</key>
          <true/>
          <key>COMMAND_STRING</key>
          <string>#!/bin/zsh
set -eu
highway="__HIGHWAY_BIN__"
if [[ ! -x "$highway" ]]; then
  osascript -e 'display alert "Highway não encontrado" message "Instale Highway.app em /Applications antes de usar este serviço."'
  exit 1
fi
input="$(cat)"
if [[ -n "$input" ]]; then
  printf '%s' "$input" | "$highway" import --curl-stdin &gt;/dev/null 2&gt;&amp;1
fi</string>
          <key>inputMethod</key>
          <integer>0</integer>
          <key>shell</key>
          <string>/bin/zsh</string>
          <key>source</key>
          <string></string>
        </dict>
